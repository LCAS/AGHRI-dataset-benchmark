<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_lidar_fusion</name>
  <version>0.0.1</version>
  <description>Adaptation of the https://github.com/Vishalkagade/Camera-Lidar-Sensor-Fusion repository to a ROS2 Humble package</description>
  <maintainer email="somebody@example.com">user</maintainer>
  <license>GLWTS</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <ros2launch/>
  </export>

</package>
